# ============================================================
# Best HCM — contoh konfigurasi environment
# ============================================================
# DEVELOPMENT dan PRODUCTION dipisah:
#
#   file                port   database
#   ------------------  -----  ---------------
#   .env.development    3005   besthcm_dev     (mirror data production)
#   .env.production     3000   besthcm_prod
#   .env                -      nilai SHARED (jangan isi DATABASE_URL di sini)
#
# Next.js otomatis memuat .env.<NODE_ENV>:
#   npm run dev  -> .env.development
#   npm start    -> .env.production
# ============================================================

# --- .env (shared) ---
AUTH_SECRET="your-auth-secret-key-at-least-32-chars-long"

# --- .env.development ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/besthcm_dev?schema=public"  # container postgres_dev

# --- .env.production ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/besthcm_prod?schema=public"

# --- Google Drive (arsip PDF bertanda tangan SPKL & Pengajuan Cuti) ---
# WAJIB untuk fitur upload dokumen. Isi di .env.development / .env.production.
# Auth = OAuth2 akun user pemilik folder (BUKAN service account: service account
# tidak punya storage quota, upload ke My Drive personal ditolak 403).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Refresh token dengan scope https://www.googleapis.com/auth/drive
GOOGLE_OAUTH_REFRESH_TOKEN=
# ID folder Drive tujuan (ambil dari URL folder: .../folders/<ID>)
GDRIVE_FOLDER_ID=
# ID folder Drive arsip Laporan Bulanan (terpisah dari folder PDF bertanda tangan).
# Bila kosong, service fallback ke GDRIVE_FOLDER_ID.
GDRIVE_LAPORAN_FOLDER_ID=

# --- opsional (dipakai scripts/*.sh) ---
# PG_CONTAINER=postgres
# PGUSER=postgres
# PROD_DB=besthcm_prod
# DEV_DB=besthcm_dev

# --- SMTP Google (lupa/reset password) ---
# SMTP_USER = alamat Gmail pengirim. SMTP_PASS = App Password 16 karakter
# (Akun Google > Keamanan > Verifikasi 2 Langkah > Sandi aplikasi).
SMTP_USER=
SMTP_PASS=
# Opsional: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_FROM="Best HCM <x@gmail.com>"
# URL publik aplikasi untuk tautan di email (tanpa slash akhir). Kosong = origin request.
APP_URL=

# --- Cron reset kuota cuti (Vercel Cron, harian 00:05 WIB) ---
# Vercel mengirim header `Authorization: Bearer <CRON_SECRET>` ke /api/cron/quota-reset.
# Isi dengan string acak panjang (mis. `openssl rand -hex 32`) di env Production.
CRON_SECRET=
