# ============================================================
# Best HCM — contoh konfigurasi environment
# ============================================================
# DEVELOPMENT dan PRODUCTION dipisah:
#
#   file                port   database
#   ------------------  -----  ---------------
#   .env.development    3005   besthcm_dev     (mirror data production)
#   .env.production     3000   besthcm_prod
#   .env                -      nilai SHARED (jangan isi DATABASE_URL di sini)
#
# Next.js otomatis memuat .env.<NODE_ENV>:
#   npm run dev  -> .env.development
#   npm start    -> .env.production
# ============================================================

# --- .env (shared) ---
AUTH_SECRET="your-auth-secret-key-at-least-32-chars-long"

# --- .env.development ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/besthcm_dev?schema=public"  # container postgres_dev

# --- .env.production ---
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/besthcm_prod?schema=public"

# --- opsional (dipakai scripts/*.sh) ---
# PG_CONTAINER=postgres
# PGUSER=postgres
# PROD_DB=besthcm_prod
# DEV_DB=besthcm_dev
