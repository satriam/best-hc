// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum LeaveCategory {
  CUTI
  IZIN_MENINGGALKAN
}

enum CalculationType {
  WORKING_DAYS
  CALENDAR_DAYS
}

enum LeaveStatus {
  ON_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
  DONE
}

enum QuotaHistoryType {
  INITIAL_QUOTA
  LEAVE_APPROVED
  LEAVE_CANCELLED
  LEAVE_REJECTED_AFTER_APPROVAL
  LEAVE_DAYS_UPDATED
  ADMIN_MANUAL_ADJUSTMENT
  ANNUAL_RESET
  BORROWED_QUOTA_DEDUCTION
}

model User {
  id              String              @id @default(uuid())
  nip             String?
  workUnit        String?
  name            String
  email           String              @unique
  password        String
  role            Role                @default(USER)
  gender          Gender              @default(MALE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  quota           LeaveQuota?
  userLeaveQuotas UserLeaveQuota[]
  leaveRequests   LeaveRequest[]
  quotaHistories  LeaveQuotaHistory[]
  spklRequests    Spkl[]              @relation("SpklRequester")
  spklSigners     SpklSigner[]

  @@map("users")
}

model LeaveQuota {
  id         String   @id @default(uuid())
  userId     String   @unique
  totalQuota Int      @default(12)
  usedQuota  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_quotas")
}

model UserLeaveQuota {
  id            String    @id @default(uuid())
  userId        String
  leaveTypeId   String
  year          Int       @default(2026)
  totalQuota    Int       @default(12)
  usedQuota     Int       @default(0)
  borrowedQuota Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
  @@map("user_leave_quotas")
}

model LeaveType {
  id              String          @id @default(uuid())
  name            String
  category        LeaveCategory   @default(CUTI)
  defaultDays     Int?
  daysDescription String?
  calculationType CalculationType @default(WORKING_DAYS)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  requestTypes    LeaveRequestType[]
  userLeaveQuotas UserLeaveQuota[]
  segments        LeaveRequestSegment[]
  quotaHistories  LeaveQuotaHistory[]

  @@map("leave_types")
}

model LeaveRequest {
  id             String             @id @default(uuid())
  userId         String
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  reason         String
  attachmentUrl  String?
  status         LeaveStatus        @default(ON_PROGRESS)
  adminNote      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestTypes   LeaveRequestType[]
  quotaHistories LeaveQuotaHistory[]
  segments       LeaveRequestSegment[]

  @@map("leave_requests")
}

/// Rentang tanggal per pengajuan cuti. Satu pengajuan bisa berisi beberapa
/// rentang (mis. 1-3 Okt cuti tahunan, 4 Okt cuti istri melahirkan,
/// 10-11 Okt cuti tahunan) dan tiap rentang punya jenis cutinya sendiri.
/// Kolom startDate/endDate/totalDays pada LeaveRequest tetap dipakai sebagai
/// envelope agregat (min start, max end, jumlah totalDays) demi kompatibilitas
/// list/filter/kalender.
model LeaveRequestSegment {
  id             String   @id @default(uuid())
  leaveRequestId String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  totalDays      Int
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId])
  @@map("leave_request_segments")
}

model LeaveRequestType {
  id             String       @id @default(uuid())
  leaveRequestId String
  leaveTypeId    String
  createdAt      DateTime     @default(now())

  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([leaveRequestId, leaveTypeId])
  @@map("leave_request_types")
}

model LeaveQuotaHistory {
  id             String           @id @default(uuid())
  userId         String
  leaveRequestId String?
  leaveTypeId    String?
  previousQuota  Int
  changeAmount   Int
  newQuota       Int
  type           QuotaHistoryType
  description    String?
  createdAt      DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveRequest   LeaveRequest?    @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  leaveType      LeaveType?       @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@index([leaveRequestId])
  @@index([userId, leaveTypeId])
  @@map("leave_quota_histories")
}

model NationalHoliday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("national_holidays")
}

// ---------------------------------------------------------------------------
// Modul SPKL (Surat Perintah Kerja Lembur)
// ---------------------------------------------------------------------------

enum SpklSignerRole {
  PIC // Yang Menugaskan
  APPROVER // Yang Menyetujui
}

enum SpklType {
  WORKDAY // Lembur Hari Kerja
  OUTSIDE_WORKDAY // Lembur Diluar Hari Kerja
  PUBLIC_HOLIDAY // Lembur Hari Libur Resmi
}

enum SpklStatus {
  DRAFT
  ON_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

/// Master penanda tangan SPKL (PIC = Yang Menugaskan, APPROVER = Yang Menyetujui).
/// Bisa berdiri sendiri (userId null) karena penanda tangan belum tentu punya akun.
model SpklSigner {
  id         String         @id @default(uuid())
  role       SpklSignerRole
  userId     String?
  name       String
  nip        String?
  position   String?
  department String?
  workUnit   String?
  isActive   Boolean        @default(true)
  isDefault  Boolean        @default(false)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user          User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedSpkls Spkl[] @relation("SpklPic")
  approvedSpkls Spkl[] @relation("SpklApprover")

  @@index([role, isActive])
  @@map("spkl_signers")
}

model Spkl {
  id           String     @id @default(uuid())
  number       String     @unique
  requesterId  String
  picId        String
  approverId   String
  type         SpklType   @default(WORKDAY)
  workUnit     String?
  status       SpklStatus @default(DRAFT)
  notes        String?
  totalHours   Decimal    @default(0) @db.Decimal(7, 2)
  approvedAt   DateTime?
  approvedById String?
  rejectedNote String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  requester User        @relation("SpklRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  pic       SpklSigner  @relation("SpklPic", fields: [picId], references: [id])
  approver  SpklSigner  @relation("SpklApprover", fields: [approverId], references: [id])
  items     SpklItem[]

  @@index([requesterId, status])
  @@index([status])
  @@map("spkls")
}

model SpklItem {
  id              String   @id @default(uuid())
  spklId          String
  order           Int      @default(0)
  workerNik       String
  workerName      String
  workerPosition  String?
  company         String?  @default("PT Bukit Energi Servis Terpadu")
  taskDescription String
  workDate        DateTime
  startTime       String
  endTime         String
  hours           Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  spkl Spkl @relation(fields: [spklId], references: [id], onDelete: Cascade)

  @@index([spklId])
  @@map("spkl_items")
}
